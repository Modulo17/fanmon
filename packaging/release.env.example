# Copy to packaging/release.env (gitignored) and fill in your values.
#   cp packaging/release.env.example packaging/release.env

# Your Developer ID Application signing identity (exact name from
# `security find-identity -v -p codesigning`).
SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# App Store Connect API key (used for notarization). Reference by path — never
# commit the .p8 itself.
ASC_KEY="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
ASC_KEY_ID="XXXXXXXXXX"
ASC_ISSUER="00000000-0000-0000-0000-000000000000"

# Optional: a real reverse-DNS bundle id for the signed build.
# Defaults to com.example.fanmon if unset.
BUNDLE_ID="com.yourdomain.fanmon"
